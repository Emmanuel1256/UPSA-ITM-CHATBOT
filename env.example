# ═══════════════════════════════════════════════════════════
# .env.example — Copy this to .env and fill in your values
# ═══════════════════════════════════════════════════════════

# Flask
SECRET_KEY=change-this-to-a-long-random-string
JWT_SECRET_KEY=change-this-jwt-secret-too

# Database (SQLite default — no change needed for FYP)
DATABASE_URL=sqlite:///upsa_itm.db

# VAPID Keys for Web Push Notifications
# Generate with: python generate_vapid_keys.py
VAPID_PRIVATE_KEY=your-private-key-here
VAPID_PUBLIC_KEY=your-public-key-here
VAPID_CLAIMS_EMAIL=mailto:admin@upsamail.edu.gh
